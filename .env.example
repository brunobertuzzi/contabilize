# ==============================================================================
# Contabilize - Variáveis de Ambiente de Exemplo (.env.example)
#
# Para utilizar:
#   1. Copie este arquivo para .env: cp .env.example .env (ou copy no Windows)
#   2. Preencha os valores conforme seu ambiente (desenvolvimento ou produção)
# ==============================================================================

# Modo de desenvolvimento (1 para habilitar debug, 0 para produção)
FLASK_DEBUG=1

# Chave secreta de sessão Flask / CSRF
# Em produção, gere uma chave criptograficamente segura via:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua_esta_chave_por_uma_chave_secreta_forte_32_bytes

# Conexão com Banco de Dados:
# Para PostgreSQL (produção ou Docker):
# DATABASE_URL=postgresql+psycopg2://contabilize:contabilize_secure_password_2026@localhost:5432/contabilize_db
#
# Para SQLite local (padrão se DATABASE_URL for omitido):
# DATABASE_URL=sqlite:///database/main.db

# Credenciais PostgreSQL para Docker Compose
POSTGRES_USER=contabilize
POSTGRES_PASSWORD=contabilize_secure_password_2026
POSTGRES_DB=contabilize_db
POSTGRES_PORT=5432

# Nível de logging da aplicação (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Porta padrão para execução em modo de desenvolvimento web (--dev)
PORT=5000
